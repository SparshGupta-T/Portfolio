# Cloudflare Pages Caching and Security Headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite bundled assets (strictly fingerprinted with content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed static project folders (1 day fresh, 7 days stale-while-revalidate with ETag)
/CheckIn/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/Johnson Controls/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/LOGOS/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/MyCouncilor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/RecycleNET/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/Scalenow Technosolutions/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/Skills Logo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/SupportFit/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/SupportRoom/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/TravelHoster/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Fonts (immutable)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Root social share images & favicons
/og-*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Resume PDF
/Sparsh_Resume.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# HTML documents (always revalidate to ensure instantaneous live updates on deploy)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
