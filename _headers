# Cloudflare Pages Caching and Security Headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite bundled assets (fingerprinted with content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static image & media formats (1-year immutable cache)
/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Static project folders
/RecycleNET/*
  Cache-Control: public, max-age=31536000, immutable

/SupportFit/*
  Cache-Control: public, max-age=31536000, immutable

/TravelHoster/*
  Cache-Control: public, max-age=31536000, immutable

/MyCouncilor/*
  Cache-Control: public, max-age=31536000, immutable

/CheckIn/*
  Cache-Control: public, max-age=31536000, immutable

/LOGOS/*
  Cache-Control: public, max-age=31536000, immutable

/SupportRoom/*
  Cache-Control: public, max-age=31536000, immutable

# PDFs (Resume)
/*.pdf
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# HTML documents (always revalidate to ensure instantaneous live updates on each new deploy)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
